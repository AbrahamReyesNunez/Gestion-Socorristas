# =====================================================
#  SOCORRISTAS
# =====================================================

### Listar todos
GET http://localhost:8080/socorristas

### Crear uno válido
POST http://localhost:8080/socorristas
Content-Type: application/json

{
  "nombre": "Lucía",
  "apellidos": "Martín Gil",
  "dni": "12345678A",
  "telefono": "600111222",
  "fechaCaducidadTitulo": "2027-06-30"
}

### Crear con datos inválidos (debe dar 400)
POST http://localhost:8080/socorristas
Content-Type: application/json

{
  "nombre": "",
  "apellidos": "Ruiz",
  "dni": "123",
  "fechaCaducidadTitulo": "2027-06-30"
}

### Buscar por id
GET http://localhost:8080/socorristas/3

### Buscar uno que no existe (debe dar 404)
GET http://localhost:8080/socorristas/99

### Actualizar
PUT http://localhost:8080/socorristas/1
Content-Type: application/json

{
  "nombre": "Lucía",
  "apellidos": "Martín Gil",
  "dni": "12345678A",
  "telefono": "699999999",
  "fechaCaducidadTitulo": "2028-06-30"
}

### Borrar
DELETE http://localhost:8080/socorristas/1


# =====================================================
#  INSTALACIONES
# =====================================================

### Listar instalaciones (al principio debe dar [] vacío)
GET http://localhost:8080/instalaciones

### Crear piscina (201)
POST http://localhost:8080/instalaciones
Content-Type: application/json

{
  "nombre": "Piscina Chipiona",
  "tipo": "PISCINA",
  "direccion": "Calle Los Álamos 13, Chipiona",
  "minimoSocorristas": 2
}

### Crear playa (201)
POST http://localhost:8080/instalaciones
Content-Type: application/json

{
  "nombre": "Playa de Regla",
  "tipo": "PLAYA",
  "direccion": "Paseo Costa Ballena, Chipiona",
  "minimoSocorristas": 4
}

### Listar instalaciones (ahora debe devolver las dos)
GET http://localhost:8080/instalaciones

### Buscar por id (200) - cambia el id por uno que exista
GET http://localhost:8080/instalaciones/1

### Buscar una que no existe (404)
GET http://localhost:8080/instalaciones/99

### Actualizar la piscina (200)
PUT http://localhost:8080/instalaciones/1
Content-Type: application/json

{
  "nombre": "Piscina Chipiona",
  "tipo": "PISCINA",
  "direccion": "Calle Los Álamos 13, Chipiona",
  "minimoSocorristas": 3
}

### Actualizar una que no existe (404)
PUT http://localhost:8080/instalaciones/99
Content-Type: application/json

{
  "nombre": "No existe",
  "tipo": "PISCINA",
  "direccion": "Calle Falsa 123",
  "minimoSocorristas": 1
}

### Crear con nombre repetido (409)
POST http://localhost:8080/instalaciones
Content-Type: application/json

{
  "nombre": "Playa de Regla",
  "tipo": "PLAYA",
  "direccion": "Otra dirección",
  "minimoSocorristas": 2
}

### Renombrar la piscina con el nombre de la playa (409)
PUT http://localhost:8080/instalaciones/1
Content-Type: application/json

{
  "nombre": "Playa de Regla",
  "tipo": "PISCINA",
  "direccion": "Calle Los Álamos 13, Chipiona",
  "minimoSocorristas": 3
}

### Datos inválidos: nombre vacío y mínimo 0 (400)
POST http://localhost:8080/instalaciones
Content-Type: application/json

{
  "nombre": "",
  "tipo": "PISCINA",
  "direccion": "Calle Mayor 1",
  "minimoSocorristas": 0
}

### Datos inválidos: falta el tipo y la dirección (400)
POST http://localhost:8080/instalaciones
Content-Type: application/json

{
  "nombre": "Piscina sin tipo",
  "minimoSocorristas": 2
}

### Tipo que no existe en el enum (400)
POST http://localhost:8080/instalaciones
Content-Type: application/json

{
  "nombre": "Piscina rara",
  "tipo": "LAGO",
  "direccion": "Calle Mayor 2",
  "minimoSocorristas": 1
}

### Borrar la playa (204)
DELETE http://localhost:8080/instalaciones/2

### Borrar otra vez la misma (404)
DELETE http://localhost:8080/instalaciones/2
